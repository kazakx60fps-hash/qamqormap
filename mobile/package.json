{
  "name": "qamqormap-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-constants": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-secure-store": "~58.0.2",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-webview": "14.0.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start --tunnel ngrok",
    "start:lan": "expo start --lan",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "sync": "node scripts/sync-shared.mjs",
    "check:shared": "node scripts/sync-shared.mjs --check",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --no-warnings --test tests/*.test.mjs",
    "export:android": "expo export --platform android --output-dir dist/android",
    "export:ios": "expo export --platform ios --output-dir dist/ios",
    "export:web": "expo export --platform web --output-dir dist-web",
    "build:apk": "npx eas-cli@latest build --platform android --profile preview",
    "build:apk:local": "expo prebuild --platform android --clean && cd android && ./gradlew assembleRelease"
  },
  "private": true
}
