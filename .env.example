# PostgreSQL қосылымы: postgres://ПАЙДАЛАНУШЫ:ҚҰПИЯСӨЗ@ХОСТ:ПОРТ/ДЕРЕКҚОР
DATABASE_URL=postgres://qamqor:your_password@localhost:5432/qamqormap
# Тесттер үшін бөлек дерекқор (тесттер оны тазалап отырады!)
TEST_DATABASE_URL=postgres://qamqor:your_password@localhost:5432/qamqormap_test
PORT=3000
# HTTPS арқылы жарияланғанда true етіңіз (cookie Secure болады)
COOKIE_SECURE=false
SESSION_DAYS=14
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5
# Қорғауға арналған бөлек демо дерекқор (әдепкі: DATABASE_URL атауына _demo қосылады). npm run demo:setup / demo / demo:reset
# DEMO_DATABASE_URL=postgres://qamqor:your_password@localhost:5432/qamqormap_demo
# Мобильді қосымшаның веб-нұсқасын браузерде тексеру үшін ғана (Android/iOS қосымшасына керек емес)
# CORS_ORIGINS=http://localhost:8081
